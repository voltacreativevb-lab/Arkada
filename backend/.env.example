# Supabase project settings — Project Settings → API in the Supabase dashboard
SUPABASE_URL=https://zmuvzdqewcrvnfyaxzhk.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the frontend

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5174

# Secret used to sign worker (radnik) PIN-login JWTs — independent from Supabase's own JWT secret
WORKER_JWT_SECRET=change-me-to-a-long-random-string

PORT=3000
